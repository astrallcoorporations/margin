# Margin and Vex are one website: Margin forwards /api and /auth to Vex.
# Where Vex is running (default http://localhost:3000). Change it when Vex is online.
VEX_TARGET=http://localhost:3000
# The address of Vex's own standalone page, used by the "Open Vex" links.
VITE_VEX_SITE=http://localhost:3000
